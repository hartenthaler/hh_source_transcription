use Fisharebest\Webtrees\I18N;
use Fisharebest\Webtrees\Tree;

?>

<h2><?= e($title) ?></h2>

<form method="post" action="<?= e(route('source-transcription-store-manual', ['tree' => $tree->name()])) ?>">
    <?= csrf_field() ?>

    <div class="row mb-3">
        <label class="col-sm-3 col-form-label" for="title">
            <?= I18N::translate('Title') ?>
        </label>
        <div class="col-sm-9">
            <input class="form-control" id="title" name="title" type="text" value="<?= e($form['prefill']['title'] ?? '') ?>" required>
        </div>
    </div>

    <div class="row mb-3">
        <label class="col-sm-3 col-form-label" for="source_xref">
            <?= I18N::translate('Source') ?>
        </label>

        <div class="col-sm-9">
            <div class="input-group">
                <select
                        class="form-select tom-select"
                        id="source_xref"
                        name="source_xref"
                        data-wt-url="<?= e($form['source_url']) ?>"
                        data-wt-i18n-no-results="<?= e($form['messages']['no_results']) ?>"
                        placeholder="<?= e($form['messages']['search_source']) ?>"
                        required
                >
                    <?php if (($form['prefill']['source_xref'] ?? '') !== '') : ?>
                        <option value="<?= e('@' . $form['prefill']['source_xref'] . '@') ?>" selected>
                            <?= e($form['prefill']['source_label']) ?>
                        </option>
                    <?php endif ?>
                </select>
            </div>
        </div>
    </div>

    <div class="row mb-3">
        <label class="col-sm-3 col-form-label" for="media_xref">
            <?= I18N::translate('Media object') ?>
        </label>

        <div class="col-sm-9">
            <select
                    class="form-select"
                    id="media_xref"
                    name="media_xref"
                    disabled
            >
                <option value=""><?= I18N::translate('Select a source first') ?></option>
            </select>

            <div class="form-text text-danger" id="media_xref_status">
                <?= I18N::translate('Select a source first') ?>
            </div>

            <div class="form-text">
                <?= I18N::translate('Only media objects linked to the selected source are shown.') ?>
            </div>
        </div>
    </div>

    <div class="row mb-3">
        <label class="col-sm-3 col-form-label" for="primary_language_tag">
            <?= I18N::translate('Primary language') ?>
        </label>
        <div class="col-sm-9">
            <select class="form-select" id="primary_language_tag" name="primary_language_tag">
                <option value=""><?= I18N::translate('Language not specified') ?></option>
                <?php foreach ($form['language_options'] as $value => $label) : ?>
                    <option value="<?= e($value) ?>"><?= e($label) ?></option>
                <?php endforeach ?>
            </select>
        </div>
    </div>

    <div class="row mb-3">
        <label class="col-sm-3 col-form-label" for="primary_script_tag">
            <?= I18N::translate('Primary script') ?>
        </label>
        <div class="col-sm-9">
            <select class="form-select" id="primary_script_tag" name="primary_script_tag">
                <option value=""><?= I18N::translate('Script not specified') ?></option>
                <?php foreach ($form['script_options'] as $value => $label) : ?>
                    <option value="<?= e($value) ?>"><?= e($label) ?></option>
                <?php endforeach ?>
            </select>
        </div>
    </div>

    <div class="row mb-3">
        <label class="col-sm-3 col-form-label" for="primary_form">
            <?= I18N::translate('Primary form') ?>
        </label>
        <div class="col-sm-9">
            <select class="form-select" id="primary_form" name="primary_form">
                <option value=""><?= I18N::translate('Form not specified') ?></option>
                <?php foreach ($form['form_options'] as $value => $label) : ?>
                    <option value="<?= e($value) ?>"><?= e($label) ?></option>
                <?php endforeach ?>
            </select>
        </div>
    </div>

    <div class="row mb-3">
        <label class="col-sm-3 col-form-label" for="initial_text">
            <?= I18N::translate('Initial text') ?>
        </label>
        <div class="col-sm-9">
            <textarea class="form-control" id="initial_text" name="initial_text" rows="10"></textarea>
        </div>
    </div>

    <button class="btn btn-primary" type="submit">
        <?= I18N::translate('Create transcription') ?>
    </button>
</form>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const sourceSelect = document.getElementById('source_xref');
        const mediaSelect = document.getElementById('media_xref');
        const mediaStatus = document.getElementById('media_xref_status');
        const languageSelect = document.getElementById('primary_language_tag');

        const mediaUrl = <?= json_encode($form['media_url'], JSON_THROW_ON_ERROR) ?>;
        const mediaFilesUrl = <?= json_encode($form['media_files_url'], JSON_THROW_ON_ERROR) ?>;
        const messages = <?= json_encode($form['messages'], JSON_THROW_ON_ERROR) ?>;
        const prefill = <?= json_encode($form['prefill'], JSON_THROW_ON_ERROR) ?>;

        function setMediaStatus(message, isWarning) {
            mediaStatus.textContent = message;
            mediaStatus.hidden = message === '';
            mediaStatus.classList.toggle('text-danger', isWarning);
            mediaStatus.classList.toggle('text-muted', !isWarning);
        }

        function resetMediaSelect(message, isWarning) {
            mediaSelect.innerHTML = '';
            const option = document.createElement('option');
            option.value = '';
            option.textContent = message;
            mediaSelect.appendChild(option);
            mediaSelect.disabled = true;
            setMediaStatus(message, isWarning);
        }

        function addMediaOption(value, label) {
            const option = document.createElement('option');
            option.value = value;
            option.textContent = label;
            mediaSelect.appendChild(option);
        }

        function applyMetadataFromMedia(mediaXref) {
            mediaXref = (mediaXref || '').replaceAll('@', '').trim();

            if (!mediaXref || languageSelect.value) {
                return;
            }

            const separator = mediaFilesUrl.includes('?') ? '&' : '?';

            fetch(mediaFilesUrl + separator + 'media_xref=' + encodeURIComponent(mediaXref), {
                headers: { 'Accept': 'application/json' }
            })
                .then(response => {
                    if (!response.ok) {
                        throw new Error('HTTP ' + response.status);
                    }
                    return response.json();
                })
                .then(items => {
                    if (!Array.isArray(items)) {
                        return;
                    }

                    for (const item of items) {
                        const language = (item.metadata?.language || '').trim();

                        if (language !== '') {
                            for (const option of languageSelect.options) {
                                if (option.value === language) {
                                    languageSelect.value = language;
                                    return;
                                }
                            }
                        }
                    }
                })
                .catch(error => {
                    console.error(error);
                });
        }

        function loadMediaForSource(sourceXref, preferredMediaXref) {
            sourceXref = (sourceXref || '').replaceAll('@', '').trim();
            preferredMediaXref = (preferredMediaXref || '').replaceAll('@', '').trim();

            if (!sourceXref) {
                resetMediaSelect(messages.select_source_first, true);
                return;
            }

            resetMediaSelect(messages.loading_media, false);

            const separator = mediaUrl.includes('?') ? '&' : '?';

            fetch(mediaUrl + separator + 'source_xref=' + encodeURIComponent(sourceXref), {
                            headers: { 'Accept': 'application/json' }
            })
                .then(response => {
                    if (!response.ok) {
                        throw new Error('HTTP ' + response.status);
                    }
                    return response.json();
                })
                .then(items => {
                    mediaSelect.innerHTML = '';

                    if (!Array.isArray(items) || items.length === 0) {
                        resetMediaSelect(messages.no_linked_media, true);
                        return;
                    }

                    const emptyOption = document.createElement('option');
                    emptyOption.value = '';
                    emptyOption.textContent = messages.no_media_selected;
                    mediaSelect.appendChild(emptyOption);

                    for (const item of items) {
                        addMediaOption(item.id, item.text);
                    }

                    if (preferredMediaXref) {
                        mediaSelect.value = preferredMediaXref;
                    } else if (items.length === 1) {
                        mediaSelect.value = items[0].id;
                    }

                    mediaSelect.disabled = false;
                    setMediaStatus(
                        mediaSelect.value
                            ? ''
                            : messages.no_media_selected,
                        true
                    );

                    applyMetadataFromMedia(mediaSelect.value);
                })
                .catch(error => {
                    console.error(error);
                    resetMediaSelect(messages.could_not_load_media, true);
                });
        }

        sourceSelect.addEventListener('change', function () {
            loadMediaForSource(sourceSelect.value);
        });

        sourceSelect.addEventListener('input', function () {
            resetMediaSelect(messages.select_source_first, true);
        });

        mediaSelect.addEventListener('change', function () {
            setMediaStatus(
                mediaSelect.value
                    ? ''
                    : messages.no_media_selected,
                true
            );
            applyMetadataFromMedia(mediaSelect.value);
        });

        if (prefill.source_xref) {
            loadMediaForSource(prefill.source_xref, prefill.media_xref || '');
        }
    });
</script>
