    <?php foreach ($dashboard['form_hidden'] as $key => $value) : ?>
        <input type="hidden" name="<?= e((string) $key) ?>" value="<?= e((string) $value) ?>">
    <?php endforeach ?>
    <input type="hidden" name="sort" value="<?= e($dashboard['current_sort']) ?>">
    <input type="hidden" name="direction" value="<?= e($dashboard['current_direction']) ?>">
    <div class="col-12 col-md-3">
        <label class="form-label" for="source-transcription-status-filter"><?= I18N::translate('Status') ?></label>
        <select class="form-select" id="source-transcription-status-filter" name="status">
            <option value=""><?= I18N::translate('All') ?></option>
            <?php foreach ($status_options as $status_key => $status_label) : ?>
                <option value="<?= e($status_key) ?>" <?= $dashboard['current_status'] === $status_key ? 'selected' : '' ?>>
                    <?= e($status_label) ?>
                </option>
            <?php endforeach ?>
        </select>
    </div>
    <div class="col-12 col-md-3">
        <label class="form-label" for="source-transcription-provider-filter"><?= I18N::translate('Transcription provider') ?></label>
        <select class="form-select" id="source-transcription-provider-filter" name="provider">
            <option value=""><?= I18N::translate('All') ?></option>
            <?php foreach ($provider_options as $provider_key) : ?>
                <option value="<?= e($provider_key) ?>" <?= $dashboard['current_provider'] === $provider_key ? 'selected' : '' ?>>
                    <?= e($dashboard['provider_labels'][$provider_key] ?? $provider_key) ?>
                </option>
            <?php endforeach ?>
        </select>
    </div>
    <div class="col-12 col-md-auto">
        <button type="submit" class="btn btn-primary"><?= MoreI18N::xlate('Filter') ?></button>
        <a class="btn btn-secondary" href="<?= e($dashboard['url']) ?>"><?= I18N::translate('Reset') ?></a>
    </div>
</form>

<div class="d-flex justify-content-between align-items-center mb-2">
    <div>
        <?php if ($dashboard['total'] > 0) : ?>
            <span class="text-muted small">
                <?= I18N::translate('%s-%s of %s', I18N::number($dashboard['first_item']), I18N::number($dashboard['last_item']), I18N::number($dashboard['total'])) ?>
            </span>
        <?php endif ?>
    </div>

    <div>
        <?php if ($dashboard['total'] > 0) : ?>
            <span class="badge bg-secondary">
                <?= I18N::plural('%s transcription', '%s transcriptions', $dashboard['total'], I18N::number($dashboard['total'])) ?>
            </span>
        <?php endif ?>
    </div>
</div>

<?php if ($dashboard['rows'] !== []) : ?>
    <table class="table table-bordered table-sm">
        <thead>
        <tr>
            <th>
                <a href="<?= e($dashboard['sort_urls']['title']) ?>">
                    <?= I18N::translate('Transcription title') ?><?= $dashboard['sort_indicators']['title'] ?>
                </a>
            </th>
            <th><?= I18N::translate('Source') ?></th>
            <th><?= MoreI18N::xlate('Media') ?></th>
            <th>
                <a href="<?= e($dashboard['sort_urls']['provider']) ?>">
                    <?= I18N::translate('Transcription provider') ?><?= $dashboard['sort_indicators']['provider'] ?>
                </a>
            </th>
            <th>
                <a href="<?= e($dashboard['sort_urls']['status']) ?>">
                    <?= I18N::translate('Status') ?><?= $dashboard['sort_indicators']['status'] ?>
                </a>
            </th>
            <th>
                <a href="<?= e($dashboard['sort_urls']['created']) ?>">
                    <?= I18N::translate('Created') ?><?= $dashboard['sort_indicators']['created'] ?>
                </a>
            </th>
            <th>
                <a href="<?= e($dashboard['sort_urls']['updated']) ?>">
                    <?= I18N::translate('Updated') ?><?= $dashboard['sort_indicators']['updated'] ?>
                </a>
            </th>
            <th><?= MoreI18N::xlate('Note') ?></th>
            <th><?= I18N::translate('Actions') ?></th>
        </tr>
        </thead>
        <tbody>
        <?php foreach ($dashboard['rows'] as $row) : ?>
            <tr class="align-top">
                <td><a href="<?= e($row['detail_url']) ?>"><?= e($row['title']) ?></a></td>
                <td><?= $row['source_html'] ?></td>
                <td><?= $row['media_html'] ?></td>
                <td>
                    <a href="<?= e($row['provider']['url']) ?>" title="<?= e($row['provider']['title']) ?>" class="<?= e($dashboard['cell_format']) ?>">
                        <?php if ($row['provider']['icon'] !== '') : ?>
                            <img src="<?= e($row['provider']['icon']) ?>" alt="" width="16" height="16" class="me-1">
                        <?php endif ?>
                        <?= e($row['provider']['label']) ?>
                    </a>
                </td>
                <td><span class="badge <?= e($row['status_badge_class']) ?>"><?= e($row['status_label']) ?></span></td>
                <td><?= $row['created_html'] ?></td>
                <td><?= $row['updated_html'] ?></td>
                <td><?= $row['note_html'] ?></td>
                <td>
                    <a class="btn btn-sm btn-secondary" href="<?= e($row['action_url']) ?>">
                        <?= I18N::translate('Open') ?>
                    </a>
                </td>
            </tr>
        <?php endforeach ?>
        </tbody>
    </table>
    <?php if ($dashboard['total_pages'] > 1) : ?>
        <nav aria-label="<?= e(I18N::translate('Pagination')) ?>">
            <ul class="pagination pagination-sm">
                <li class="page-item <?= $dashboard['pagination']['disabled_previous'] ? 'disabled' : '' ?>">
                    <a class="page-link" href="<?= e($dashboard['pagination']['previous']) ?>"><?= I18N::translate('Previous') ?></a>
                </li>
                <?php foreach ($dashboard['pagination']['pages'] as $page) : ?>
                    <li class="page-item <?= $page['active'] ? 'active' : '' ?>">
                        <a class="page-link" href="<?= e($page['url']) ?>"><?= I18N::number($page['number']) ?></a>
                    </li>
                <?php endforeach ?>
                <li class="page-item <?= $dashboard['pagination']['disabled_next'] ? 'disabled' : '' ?>">
                    <a class="page-link" href="<?= e($dashboard['pagination']['next']) ?>"><?= MoreI18N::xlate('Next') ?></a>
                </li>
            </ul>
        </nav>
    <?php endif ?>
<?php else : ?>
    <div class="alert alert-info">
        <?= I18N::translate('No transcriptions match the selected filters.') ?>
    </div>
<?php endif ?>
</div>
</section>

<?php if ($transkribus_job_rows !== []) : ?>
    <section class="mt-5">
    <div class="d-flex justify-content-between align-items-center gap-2 mb-3">
        <h3 class="mb-0"><?= I18N::translate('Transkribus jobs') ?></h3>
        <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#source-transcription-dashboard-transkribus-jobs" aria-expanded="true" aria-controls="source-transcription-dashboard-transkribus-jobs">
            <?= I18N::translate('Show/hide') ?>
        </button>
    </div>

    <div class="collapse show" id="source-transcription-dashboard-transkribus-jobs">
    <table class="table table-bordered table-sm mb-0">
        <thead>
            <tr>
                <th><?= I18N::translate('Job title') ?></th>
                <th><?= I18N::translate('Source') ?></th>
                <th><?= MoreI18N::xlate('Media') ?></th>
                <th><?= I18N::translate('Status') ?></th>
                <th><?= I18N::translate('Upload references') ?></th>
                <th><?= I18N::translate('Message') ?></th>
            </tr>
        </thead>
        <tbody>
            <?php foreach ($transkribus_job_rows as $job) : ?>
                <tr>
                    <td>#<?= e($job['id']) ?> <?= e($job['title']) ?></td>
                    <td><?= $job['source_html'] ?></td>
                    <td><?= $job['media_html'] ?></td>
                    <td><span class="badge <?= e($job['badge_class']) ?>"><?= e($job['status_label']) ?></span></td>
                    <td>
                        <?php foreach ($job['files'] as $file) : ?>
                            <div class="small">
                                <?= e($file['filename']) ?>:
                                <?php if ($file['upload_reference'] !== '') : ?>
                                    <code><?= e($file['upload_reference']) ?></code>
                                <?php else : ?>
                                    <span class="<?= e($dashboard['muted']) ?>"><?= e($file['status_label']) ?></span>
                                <?php endif ?>
                                <?php if ($file['message'] !== '') : ?>
                                    <div class="text-danger"><?= e($file['message']) ?></div>
                                <?php endif ?>
                            </div>
                        <?php endforeach ?>
                    </td>
                    <td><?= e($job['last_message']) ?></td>
                </tr>
            <?php endforeach ?>
        </tbody>
    </table>
    </div>
    </section>
<?php endif ?>
