<script>
    document.addEventListener('DOMContentLoaded', function () {
        const layoutStorageKey = 'hh_source_transcription.detail_layout';
        const workspace = document.querySelector('[data-source-transcription-workspace]');
        const layoutButtons = document.querySelectorAll('[data-source-transcription-layout]');
        const mediaPanel = document.querySelector('[data-source-transcription-panel="media"]');
        const notePanel = document.querySelector('[data-source-transcription-panel="note"]');
        const noteText = document.getElementById('current_note_text');

        function setLayout(layout) {
            const vertical = layout === 'vertical';

            if (!workspace || !mediaPanel || !notePanel) {
                return;
            }

            mediaPanel.classList.toggle('col-md-6', !vertical);
            notePanel.classList.toggle('col-md-6', !vertical);
            mediaPanel.classList.toggle('col-12', vertical);
            notePanel.classList.toggle('col-12', vertical);
            notePanel.classList.toggle('mt-3', vertical);
            workspace.dataset.sourceTranscriptionWorkspace = layout;

            layoutButtons.forEach(function (button) {
                const active = button.dataset.sourceTranscriptionLayout === layout;
                button.classList.toggle('active', active);
                button.setAttribute('aria-pressed', active ? 'true' : 'false');
            });
        }

        if (workspace && mediaPanel && notePanel) {
            const savedLayout = localStorage.getItem(layoutStorageKey);
            setLayout(savedLayout === 'vertical' ? 'vertical' : 'side-by-side');

            layoutButtons.forEach(function (button) {
                button.addEventListener('click', function () {
                    const layout = button.dataset.sourceTranscriptionLayout === 'vertical' ? 'vertical' : 'side-by-side';
                    localStorage.setItem(layoutStorageKey, layout);
                    setLayout(layout);
                });
            });
        }

        function copyNoteTextToStatusForm(form) {
            const hiddenNoteText = form.querySelector('input[name="note_text"]');

            if (hiddenNoteText) {
                hiddenNoteText.value = noteText.value;
                hiddenNoteText.disabled = false;
            }
        }

        if (!noteText) {
            return;
        }

        document.querySelectorAll('button[form="source-transcription-collaboration-status-form"][value="finalize"], button[form="source-transcription-manual-status-form"][value="finalize"]').forEach(function (button) {
            button.addEventListener('click', function () {
                const form = document.getElementById(button.getAttribute('form'));

                if (form) {
                    copyNoteTextToStatusForm(form);
                }
            });
        });

        document.querySelectorAll('#source-transcription-collaboration-status-form, #source-transcription-manual-status-form').forEach(function (form) {
            form.addEventListener('submit', function (event) {
                const submitter = event.submitter;

                if (submitter && (submitter.value === 'finalize' || submitter.value === 'approve')) {
                    copyNoteTextToStatusForm(form);
                }
            });
        });
    });
</script>

